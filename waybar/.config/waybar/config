{
  "layer": "top",
  "position": "top",
  "height": 36,
  "spacing": 0,
  "margin-top": 4,
  "margin-left": 8,
  "margin-right": 8,

  "modules-left": ["custom/launcher", "niri/workspaces", "custom/cava", "niri/window"],
  "modules-center": ["clock"],
  "modules-right": ["mpris", "group/hw", "custom/screen-time", "custom/updates", "tray"],

  "custom/launcher": {
    "format": "\uf322",
    "on-click": "pkill fuzzel || fuzzel",
    "tooltip-format": "Launcher"
  },

  "niri/workspaces": {
    "format": "{name}",
    "on-click": "activate"
  },

  // ── audio visualiser (script-based, works on any waybar build) ──
  // script lives at ~/.config/waybar/scripts/cava.sh and needs `cava` installed
  "custom/cava": {
    "exec": "~/.config/waybar/scripts/cava.sh",
    "format": "{}",
    "tooltip": false
  },

  "niri/window": {
    "format": "{title}",
    "max-length": 18,
    "separate-outputs": true,
    "rewrite": {
      "(.*) — Mozilla Firefox": "$1",
      "(.*) - Google Chrome": "$1",
      "(.*) - YouTube": "$1"
    }
  },

  // now playing (hides itself when no player is running)
  "mpris": {
    "format": "{player_icon} {title} - {artist}",
    "format-paused": "{status_icon} {title}",
    "player-icons": { "default": "󰎆" },
    "status-icons": { "paused": "󰏤" },
    "max-length": 38,
    "on-click": "playerctl play-pause",
    "on-scroll-up": "playerctl next",
    "on-scroll-down": "playerctl previous",
    "tooltip-format": "{player}: {title}\n{artist} — {album}"
  },

  "clock": {
    "interval": 1,
    "format": "{:%a %d %b  %H:%M:%S}",
    "tooltip-format": "<tt><small>{calendar}</small></tt>",
    "calendar": {
      "mode": "month",
      "on-scroll": 1,
      "format": {
        "months": "<span color='#cba6f7'><b>{}</b></span>",
        "weekdays": "<span color='#6c7086'>{}</span>",
        "today": "<span color='#89b4fa'><b><u>{}</u></b></span>"
      }
    },
    "actions": { "on-scroll-up": "shift_up", "on-scroll-down": "shift_down" }
  },

  // ── one combined pill for hardware stuff ──
  "group/hw": {
    "orientation": "horizontal",
    "modules": ["idle_inhibitor", "pulseaudio", "backlight", "network", "battery"]
  },

  // click to keep the screen awake (eye = awake, slashed eye = normal)
  "idle_inhibitor": {
    "format": "{icon}",
    "format-icons": { "activated": "\uf06e", "deactivated": "\uf070" },
    "tooltip-format-activated": "Staying awake",
    "tooltip-format-deactivated": "Idle allowed"
  },

  "pulseaudio": {
    "scroll-step": 5,
    "max-volume": 150,
    "format": "{icon} {volume}%",
    "format-bluetooth": "\uf293 {volume}%",
    "format-icons": ["\uf026", "\uf027", "\uf028"],
    "format-muted": "\udb81\udf5f muted",
    "on-click": "pavucontrol"
  },

  "backlight": {
    "tooltip": false,
    "format": "{icon} {percent}%",
    "format-icons": ["󰃠"],
    "on-scroll-up": "brightnessctl --exponent=2 set 2%+",
    "on-scroll-down": "brightnessctl --exponent=2 set 2%-"
  },

  "network": {
    "interval": 2,
    "format-wifi": "\uf1eb  {essid}",
    "format-ethernet": "󰈀 {ipaddr}",
    "format-disconnected": "󰤮",
    "tooltip-format": "{ipaddr}\n↓ {bandwidthDownBits} ↑ {bandwidthUpBits}"
  },

  "battery": {
    "states": { "warning": 30, "critical": 15 },
    "format": "{icon} {capacity}%",
    "format-charging": "󰂄 {capacity}%",
    "format-plugged": "󰂄 {capacity}%",
    "format-full": "󱈑 {capacity}%",
    "format-icons": ["󱊡", "󱊢", "󱊣"],
    "tooltip-format": "{timeTo}\n{power}W · {health}% health"
  },

  "custom/screen-time": {
    "tooltip": true,
    "format": "\uf017 {text}",
    "exec": "screen-time",
    "hide-empty-text": true,
    "interval": 60,
    "return-type": "json"
  },

  "custom/updates": {
    "exec": "updates.sh",
    "hide-empty-text": true,
    "interval": 1800,
    "return-type": "json",
    "on-click": "kitty -e bash -c 'yay -Syu || sudo pacman -Syu'"
  },

  "tray": {
    "spacing": 8
  }
}
