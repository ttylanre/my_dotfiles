{
  "layer": "top",
  "position": "top",
  "height": 36,
  "spacing": 0,
  "margin-top": 4,
  "margin-left": 8,
  "margin-right": 8,

  "modules-left": ["custom/launcher", "niri/workspaces", "custom/cava", "niri/window"],
  "modules-center": ["clock"],
  "modules-right": ["mpris", "group/hw", "group/stats", "custom/screen-time", "custom/updates", "tray", "custom/notification", "custom/power"],

  "custom/launcher": {
    "format": "\uf322",
    "on-click": "pkill fuzzel || fuzzel",
    "tooltip-format": "Launcher"
  },

  "niri/workspaces": {
    "format": "{name}",
    "on-click": "activate"
  },

  // ── audio visualiser (script-based, works on any waybar build) ──
  // script lives at ~/.config/waybar/scripts/cava.sh and needs `cava` installed
  "custom/cava": {
    "exec": "~/.config/waybar/scripts/cava.sh",
    "return-type": "json",
    "format": "{}",
    "tooltip": false
  },

  "niri/window": {
    "format": "{title}",
    "max-length": 18,
    "separate-outputs": true,
    "rewrite": {
      "(.*) — Mozilla Firefox": "$1",
      "(.*) - Google Chrome": "$1",
      "(.*) - YouTube": "$1"
    }
  },

  // now playing (hides itself when no player is running)
  "mpris": {
    "format": "{player_icon} {title} - {artist}",
    "format-paused": "{status_icon} {title}",
    "player-icons": { "default": "󰎆" },
    "status-icons": { "paused": "󰏤" },
    "max-length": 22,
    "on-click": "playerctl play-pause",
    "on-scroll-up": "playerctl next",
    "on-scroll-down": "playerctl previous",
    "tooltip-format": "{player}: {title}\n{artist} — {album}"
  },

  "clock": {
    "interval": 1,
    "format": "{:%a %d %b  %H:%M}",
    "format-alt": "{:%A, %d %B %Y  ·  %H:%M:%S}",
    "tooltip-format": "<tt><small>{calendar}</small></tt>",
    "calendar": {
      "mode": "month",
      "on-scroll": 1,
      "format": {
        "months": "<span color='#cba6f7'><b>{}</b></span>",
        "weekdays": "<span color='#6c7086'>{}</span>",
        "today": "<span color='#89b4fa'><b><u>{}</u></b></span>"
      }
    },
    "actions": { "on-scroll-up": "shift_up", "on-scroll-down": "shift_down" }
  },

  // ── one combined pill for hardware stuff ──
  "group/hw": {
    "orientation": "horizontal",
    "modules": ["group/volume", "group/brightness", "network", "battery"]
  },

  // icon only; hover it and a slider slides out
  "group/volume": {
    "orientation": "horizontal",
    "drawer": { "transition-duration": 400, "transition-left-to-right": true },
    "modules": ["pulseaudio", "pulseaudio/slider"]
  },

  "group/brightness": {
    "orientation": "horizontal",
    "drawer": { "transition-duration": 400, "transition-left-to-right": true },
    "modules": ["backlight", "backlight/slider"]
  },

  "pulseaudio": {
    "scroll-step": 5,
    "max-volume": 150,
    "format": "{icon}",
    "format-bluetooth": "\uf293",
    "format-muted": "\udb81\udf5f",
    "format-icons": ["\udb81\udd7f", "\udb81\udd80", "\udb81\udd7e"],
    "tooltip-format": "{desc}\n{volume}%",
    "on-click": "pactl set-sink-mute @DEFAULT_SINK@ toggle",
    "on-click-right": "pavucontrol"
  },

  "pulseaudio/slider": {
    "min": 0,
    "max": 100,
    "orientation": "horizontal"
  },

  "backlight": {
    "format": "{icon}",
    "format-icons": ["󰃞", "󰃝", "󰃟", "󰃠"],
    "tooltip-format": "{percent}%",
    "on-scroll-up": "brightnessctl --exponent=2 set 2%+",
    "on-scroll-down": "brightnessctl --exponent=2 set 2%-"
  },

  "backlight/slider": {
    "min": 5,
    "max": 100,
    "orientation": "horizontal"
  },

  // icon only; details in the tooltip, right-click for a menu
  "network": {
    "interval": 5,
    "format-wifi": "\udb81\udda9",
    "format-ethernet": "󰈀",
    "format-disconnected": "󰤮",
    "format-disabled": "󰤮",
    "tooltip-format-wifi": "{essid}\n{frequency}GHz · {signalStrength}%\n↑ {bandwidthUpBytes}  ↓ {bandwidthDownBytes}",
    "tooltip-format-ethernet": "{ifname} · {ipaddr}\n↑ {bandwidthUpBytes}  ↓ {bandwidthDownBytes}",
    "tooltip-format-disconnected": "No network connection",
    "tooltip-format-disabled": "Network disabled",
    "on-click": "kitty -e nmtui",
    "menu": "on-click-right",
    "menu-file": "~/.config/waybar/context/network.xml",
    "menu-actions": {
      "action-1": "bash -c '[[ $(nmcli radio wifi) == enabled ]] && nmcli radio wifi off || nmcli radio wifi on'",
      "action-2": "kitty -e nmtui",
      "action-3": "nm-connection-editor"
    }
  },

  "battery": {
    "states": { "warning": 30, "critical": 15 },
    "format": "{icon} {capacity}%",
    "format-charging": "󰂄 {capacity}%",
    "format-plugged": "󰂄 {capacity}%",
    "format-full": "󱈑 {capacity}%",
    "format-icons": ["󱊡", "󱊢", "󱊣"],
    "tooltip-format": "{timeTo}\n{power}W · {health}% health"
  },

  // ── stats drawer: click the chevron to reveal CPU / RAM / temp ──
  "group/stats": {
    "orientation": "horizontal",
    "drawer": {
      "transition-duration": 400,
      "transition-left-to-right": false,
      "click-to-reveal": true
    },
    "modules": ["custom/arrow", "cpu", "memory", "temperature"]
  },

  "custom/arrow": {
    "format": "\uf104",
    "tooltip": false
  },

  "cpu": {
    "interval": 3,
    "format": "\uf2db {usage}%",
    "states": { "warning": 80, "critical": 90 }
  },

  "memory": {
    "interval": 5,
    "format": "\udb80\udf5b {percentage}%",
    "tooltip-format": "{used:0.1f}G / {total:0.1f}G used",
    "states": { "warning": 80, "critical": 90 }
  },

  "temperature": {
    "interval": 5,
    "format": "{icon} {temperatureC}°",
    "critical-threshold": 85,
    "format-icons": ["\uf2cb", "\uf2ca", "\uf2c9", "\uf2c8", "\uf2c7"]
  },

  // swaync: left-click toggles the panel, right-click toggles Do Not Disturb
  "custom/notification": {
    "tooltip": false,
    "format": "{icon}",
    "format-icons": {
      "notification": "\uf0f3<span foreground='#f38ba8'><sup>\uf111</sup></span>",
      "none": "\uf0a2",
      "dnd-notification": "\uf1f6<span foreground='#f38ba8'><sup>\uf111</sup></span>",
      "dnd-none": "\uf1f6",
      "inhibited-notification": "\uf0f3<span foreground='#f38ba8'><sup>\uf111</sup></span>",
      "inhibited-none": "\uf0a2",
      "dnd-inhibited-notification": "\uf1f6<span foreground='#f38ba8'><sup>\uf111</sup></span>",
      "dnd-inhibited-none": "\uf1f6"
    },
    "return-type": "json",
    "exec-if": "which swaync-client",
    "exec": "swaync-client -swb",
    "on-click": "swaync-client -t -sw",
    "on-click-right": "swaync-client -d -sw",
    "escape": true
  },

  // left-click opens the power menu
  "custom/power": {
    "format": "\uf011",
    "tooltip": false,
    "menu": "on-click",
    "menu-file": "~/.config/waybar/context/power.xml",
    "menu-actions": {
      "action-1": "~/.config/waybar/scripts/lock.sh",
      "action-2": "systemctl suspend",
      "action-3": "niri msg action quit",
      "action-4": "systemctl reboot",
      "action-5": "systemctl poweroff"
    }
  },

  "custom/screen-time": {
    "tooltip": true,
    "format": "\uf017 {text}",
    "exec": "screen-time",
    "hide-empty-text": true,
    "interval": 60,
    "return-type": "json"
  },

  "custom/updates": {
    "exec": "updates.sh",
    "hide-empty-text": true,
    "interval": 1800,
    "return-type": "json",
    "on-click": "kitty -e bash -c 'yay -Syu || sudo pacman -Syu'"
  },

  "tray": {
    "spacing": 8
  }
}
