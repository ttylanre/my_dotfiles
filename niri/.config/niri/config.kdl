// ════════════════════════════════════════════════════════════════════════════
//  niri config — Catppuccin Mocha rice
//  Rule order matters: in window-rule / layer-rule, LATER rules override
//  EARLIER ones, so general rules come first and specific ones last.
// ════════════════════════════════════════════════════════════════════════════

// ── Input ───────────────────────────────────────────────────────────────────
input {
    keyboard {
        xkb {
            layout "us"
            // options "caps:escape"   // uncomment to remap Caps → Escape
        }
        repeat-delay 300
        repeat-rate 50
    }

    touchpad {
        tap
        dwt                          // disable while typing
        natural-scroll
		middle-emulation             // Enables simultaneous L+R click as middle click
        accel-speed 0.2
        click-method "clickfinger"
    }

    mouse {
        accel-speed 0.0
    }

    // focus-follows-mouse max-scroll-amount="0%"   // optional: sloppy focus
    // warp-mouse-to-focus

    disable-power-key-handling
}

cursor {
    hide-when-typing
    hide-after-inactive-ms 4000
}

// ── Outputs ─────────────────────────────────────────────────────────────────
// Left: laptop panel. Right: external HDMI display.
// output "eDP-1" {
//     mode "1366x768@60.000"
//     position x=0 y=0
//     scale 1.0
// }
//
// output "HDMI-A-1" {
//     mode "1920x1080@60.000"
//     position x=1366 y=0
//     scale 1.3
// }

// top: external HDMI display. bottom-center: laptop panel.
output "HDMI-A-1" {
    mode "1920x1080@60.000"
    position x=0 y=0
    scale 1.3
}

output "eDP-1" {
    mode "1366x768@60.000"
    position x=55 y=831
    scale 1.0
}

// To turn the laptop panel off when docked:
// output "eDP-1" { off; }

// ── General ─────────────────────────────────────────────────────────────────
prefer-no-csd

screenshot-path "~/Pictures/Screenshots/Screenshot from %Y-%m-%d %H-%M-%S.png"

hotkey-overlay {
    skip-at-startup
}

// X11 apps go through an external xwayland-satellite on :1
// (niri's built-in integration is disabled below).
environment {
    DISPLAY ":1"
    _JAVA_AWT_WM_NONREPARENTING "1"
    AWT_TOOLKIT "MToolkit"
}

xwayland-satellite {
    on
}

// ── Layout ──────────────────────────────────────────────────────────────────
layout {
    gaps 8
    center-focused-column "never"

    preset-column-widths {
        proportion 0.33333
        proportion 0.5
        proportion 0.66667
        proportion 1.0
    }

    preset-window-heights {
        proportion 0.33333
        proportion 0.5
        proportion 0.66667
        proportion 1.0
    }

    default-column-width { proportion 0.5; }

    focus-ring {
        width 2
        active-gradient from="#89b4fa" to="#cba6f7" angle=45 relative-to="workspace-view"
        inactive-color "#313244"
        urgent-color "#f38ba8"
    }

    border {
        off
    }

    // Soft shadows on every window: the focused one gets a faint blue glow
    // (Catppuccin blue), unfocused ones a plain dark shadow.
    shadow {
        on
        softness 40
        spread 4
        offset x=0 y=6
        color "#89b4fa30"
        inactive-color "#00000050"
    }

    // Used by tabbed columns (Mod+Alt+T)
    tab-indicator {
        hide-when-single-tab
        place-within-column
        width 4
        gap 4
        corner-radius 4
        active-color "#89b4fa"
        inactive-color "#313244"
        urgent-color "#f38ba8"
    }
}

// ── Animations ──────────────────────────────────────────────────────────────
animations {
    // Set to 3.0 when you want to inspect the shaders in slow motion
    slowdown 2.0

    // ── Window open: tilt-in ─────────────────────────────────────
    // Starts tipped back in perspective and slightly small, then swings
    // flat while a soft wipe reveals it top to bottom. A faint colour
    // fringe shrinks to nothing. No brightness changes anywhere.
    window-open {
        duration-ms 260
        curve "linear"
        custom-shader r"
            vec4 fx_tex(vec2 uv) {
                if (uv.x < 0.0 || uv.x > 1.0 || uv.y < 0.0 || uv.y > 1.0) return vec4(0.0);
                return texture2D(niri_tex, (niri_geo_to_tex * vec3(uv, 1.0)).st);
            }

            // inverse-map a plane rotated around its horizontal centre axis
            vec2 fx_tilt(vec2 uv, float theta) {
                float d = 2.0;
                vec2 s = uv - 0.5;
                float den = d * cos(theta) - s.y * sin(theta);
                float yp = s.y * d / den;
                float xp = s.x * (d + yp * sin(theta)) / d;
                return vec2(xp, yp) + 0.5;
            }

            vec4 open_color(vec3 coords_geo, vec3 size_geo) {
                float p = niri_clamped_progress;
                float g = pow(1.0 - p, 3.0);          // 1 -> 0, ease-out
                float e = 1.0 - g;

                vec2 uv = coords_geo.xy;
                uv = (uv - 0.5) / mix(0.92, 1.0, e) + 0.5;   // slight scale-up
                uv = fx_tilt(uv, 0.6 * g * g);               // swing flat

                float split = g * g * 0.012;                 // fringe shrinks only
                vec4 sr = fx_tex(uv + vec2(split, 0.0));
                vec4 sg = fx_tex(uv);
                vec4 sb = fx_tex(uv - vec2(split, 0.0));
                vec4 c = vec4(sr.r, sg.g, sb.b, max(sr.a, max(sg.a, sb.a)));

                // feathered wipe, top to bottom
                float reveal = smoothstep(0.0, 0.35, e * 1.35 - coords_geo.y);
                return c * reveal;
            }
        "
    }

    // ── Window close: tilt-out ───────────────────────────────────
    // The exact time-reverse of the open: tips back, shrinks a little,
    // and wipes away from the bottom up.
    window-close {
        duration-ms 240
        curve "linear"
        custom-shader r"
            vec4 fx_tex(vec2 uv) {
                if (uv.x < 0.0 || uv.x > 1.0 || uv.y < 0.0 || uv.y > 1.0) return vec4(0.0);
                return texture2D(niri_tex, (niri_geo_to_tex * vec3(uv, 1.0)).st);
            }

            vec2 fx_tilt(vec2 uv, float theta) {
                float d = 2.0;
                vec2 s = uv - 0.5;
                float den = d * cos(theta) - s.y * sin(theta);
                float yp = s.y * d / den;
                float xp = s.x * (d + yp * sin(theta)) / d;
                return vec2(xp, yp) + 0.5;
            }

            vec4 close_color(vec3 coords_geo, vec3 size_geo) {
                float p = niri_clamped_progress;
                float g = p * p * p;                  // 0 -> 1, ease-in
                float e = 1.0 - g;

                vec2 uv = coords_geo.xy;
                uv = (uv - 0.5) / mix(0.92, 1.0, e) + 0.5;
                uv = fx_tilt(uv, 0.6 * g * g);

                float split = g * g * 0.012;
                vec4 sr = fx_tex(uv + vec2(split, 0.0));
                vec4 sg = fx_tex(uv);
                vec4 sb = fx_tex(uv - vec2(split, 0.0));
                vec4 c = vec4(sr.r, sg.g, sb.b, max(sr.a, max(sg.a, sb.a)));

                float reveal = smoothstep(0.0, 0.35, e * 1.35 - coords_geo.y);
                return c * reveal;
            }
        "
    }

    // ── Resize: chromatic crossfade ──────────────────────────────
    // Crossfades old/new contents with an RGB split that peaks mid-resize.
    //window-resize {
    //    spring damping-ratio=0.9 stiffness=600 epsilon=0.0001
    //    custom-shader r"
    //        vec4 resize_color(vec3 coords_curr_geo, vec3 size_curr_geo) {
    //            float p   = niri_clamped_progress;
    //            float amt = sin(p * 3.14159265) * 0.012;
    //            vec3 off  = vec3(amt, 0.0, 0.0);

    //            vec4 pr = texture2D(niri_tex_prev, (niri_geo_to_tex_prev * (coords_curr_geo + off)).st);
    //            vec4 pg = texture2D(niri_tex_prev, (niri_geo_to_tex_prev *  coords_curr_geo).st);
    //            vec4 pb = texture2D(niri_tex_prev, (niri_geo_to_tex_prev * (coords_curr_geo - off)).st);

    //            vec4 nr = texture2D(niri_tex_next, (niri_geo_to_tex_next * (coords_curr_geo + off)).st);
    //            vec4 ng = texture2D(niri_tex_next, (niri_geo_to_tex_next *  coords_curr_geo).st);
    //            vec4 nb = texture2D(niri_tex_next, (niri_geo_to_tex_next * (coords_curr_geo - off)).st);

    //            vec4 prev = vec4(pr.r, pg.g, pb.b, pg.a);
    //            vec4 next = vec4(nr.r, ng.g, nb.b, ng.a);
    //            return mix(prev, next, p);
    //        }
    //    "
    //}

    window-resize {
        spring damping-ratio=0.85 stiffness=500 epsilon=0.0001
    }

    // ── Screenshot UI: shaders aren't supported here ─────────────
    screenshot-ui-open {
        duration-ms 200
        curve "ease-out-quad"
    }

    // ── Springs ──────────────────────────────────────────────────
    // Rule of thumb: things you trigger constantly (focus moves, workspace
    // switches) are close to critically damped; rarer things can overshoot.
    workspace-switch {
        spring damping-ratio=0.85 stiffness=700 epsilon=0.0001
    }

    horizontal-view-movement {
        spring damping-ratio=1.0 stiffness=800 epsilon=0.0001
    }

    // The one deliberately jelly animation
    window-movement {
        spring damping-ratio=0.78 stiffness=650 epsilon=0.0001
    }

    config-notification-open-close {
        spring damping-ratio=0.65 stiffness=700 epsilon=0.001
    }

    overview-open-close {
        spring damping-ratio=0.9 stiffness=600 epsilon=0.0005
    }
}

// ── Overview ────────────────────────────────────────────────────────────────
overview {
    // Dark frosted backdrop — matches waybar
    backdrop-color "#11111bcc"

    workspace-shadow {
        on
        softness 40
        spread 5
        offset x=0 y=8
        color "#00000066"
    }
}

recent-windows {
    // Snappy: appears almost instantly, commits focus quickly
    debounce-ms 300
    open-delay-ms 60

    highlight {
        // Mauve frame, the far end of your focus-ring gradient.
        // Alpha keeps it soft against the dimmed backdrop.
        active-color "#89b4fae6"
        // Red, shown darker on unfocused windows that are urgent
        urgent-color "#fab387"
        padding 7
        // Concentric with your 12px window corners: 12 + 20 padding
        corner-radius 6
    }

    previews {
        // Bigger previews so you can actually read window contents.
        // On your 1366x768 laptop panel max-scale (0.6) is the limit,
        // on the 1.3x HDMI display max-height is.
        max-height 400
        max-scale 0.5
    }

    binds {
        Alt+Tab         { next-window; }
        Alt+Shift+Tab   { previous-window; }
        Alt+grave       { next-window     filter="app-id"; }
        Alt+Shift+grave { previous-window filter="app-id"; }

        Mod+Alt+Tab       { next-window     scope="output"; }
        Mod+Alt+Shift+Tab { previous-window scope="output"; }
    }
}

// ── Workspaces ──────────────────────────────────────────────────────────────
// Nerd Font glyphs written as escapes so they can't get lost in copy/paste:
//   f120 = terminal, f0ac = globe, f121 = code
// Make sure these match your waybar workspace config / format-icons.
workspace "\u{f120}"
workspace "\u{f0ac}"
workspace "\u{f121}"
workspace "stash"

// Pin workspaces to a monitor (optional):
// workspace "\u{f0ac}" { open-on-output "HDMI-A-1"; }

// ── Layer Rules ─────────────────────────────────────────────────────────────
//layer-rule {
//    match namespace="waybar"
//    opacity 0.8
//    background-effect {
//        xray true
//        blur true
//    }
//}

layer-rule {
    match namespace="swaync-notification-window"
    block-out-from "screen-capture"
}

//layer-rule {
//    match namespace="swaync-control-center"
//    background-effect {
//        xray false
//        blur true
//    }
//}

layer-rule {
    match namespace="syshud"
    background-effect {
        xray false
        blur true
    }
    geometry-corner-radius 24
}

layer-rule {
    match namespace="launcher"
    background-effect {
        xray false
        blur true
    }
    geometry-corner-radius 6
}

layer-rule {
    match namespace=r#"^logout_dialog$"#
    background-effect {
        xray false
        blur true
    }
}

// Second awww instance (named "overview-wall") draws the wallpaper behind the overview
layer-rule {
    match namespace="^awww-daemonoverview-wall$"
    place-within-backdrop true
}

// ── Window Rules ────────────────────────────────────────────────────────────

// ·· Global defaults ··
window-rule {
    draw-border-with-background false
    geometry-corner-radius 12
    clip-to-geometry true
}

// ·· Floating TUI overlays (Mod+Ctrl+… launchers) ··
window-rule {
    match app-id=r#"^tui-overlay$"#
    open-floating true
    default-column-width { fixed 850; }
    default-window-height { fixed 550; }
    opacity 0.95
    background-effect {
        blur true
    }
}

// ·· Scratchpad terminal (Mod+S) ··
window-rule {
    match app-id=r#"^scratchpad$"#
    open-floating true
    default-column-width { fixed 1000; }
    default-window-height { fixed 600; }
    opacity 0.92
    background-effect {
        blur true
    }
}

// ·· Wallpaper picker ··
window-rule {
    match app-id="wallpaper-picker"
    open-floating true
    default-column-width { fixed 1000; }
    default-window-height { fixed 650; }
}

// ·· Blur for GTK/utility apps ··
window-rule {
    match app-id=r#"^org\.gnome\.Nautilus$"#
    match app-id=r#"^org\.gnome\.Papers$"#
    match app-id=r#"^org\.gnome\.Loupe$"#
    match app-id=r#"^io\.github\.celluloid_player\.Celluloid$"#
    match app-id=r#"^zenity$"#
    background-effect {
        xray false
        blur true
    }
}

// ·· Always-floating dialogs & small tools ··
window-rule {
    match app-id=r#"^org\.kde\.kdeconnect\.daemon$"#
    match app-id=r#"^org\.kde\.kdeconnect\.handler$"#
    match app-id=r#"^galculator$"#
    match app-id=r#"^org\.kde\.kcalc$"#
    match app-id=r#"^org\.gnome\.Calendar$"#
    match app-id=r#"^org\.gnome\.Loupe$"#
    match app-id=r#"^zenity$"#
    match app-id=r#"^Tk$"#
    match app-id=r#"^[Jj]ava$"#
    match app-id=r#"^Vivado$"# title="^win0$"
    match app-id=r#"^Vivado 2022\.2 Installer$"#
    match app-id=r#"^Eclipse$"# title="^Eclipse IDE Launcher $"
    match app-id=r#"^STM32CubeIDE$"# title="^STM32CubeIDE Launcher $"
    match app-id=r#"^com-st-microxplorer-maingui-STM32CubeMX$"# title="^win0$"
    open-floating true
}

// ·· File managers — constrained floating size + translucency ··
// (Rename / progress dialogs are excluded so they keep their natural size)
window-rule {
    match app-id=r#"^thunar$"#
    match app-id=r#"^org\.gnome\.Nautilus$"#
    match app-id=r#"^pcmanfm$"#
    exclude app-id=r#"^thunar$"# title="^(File Operation Progress|Rename)"
    min-width 800
    max-width 1176
    min-height 600
    max-height 600
    open-floating true
}

window-rule {
    match app-id=r#"^thunar$"#
    match app-id=r#"^pcmanfm$"#
    opacity 0.72
    background-effect {
        xray true
        blur true
    }
}

// Thunar small dialogs
window-rule {
    match app-id=r#"^thunar$"# title="^(File Operation Progress|Rename)"
    open-floating true
}

// Because why not (niri easter egg)
window-rule {
    match app-id=r#"^thunar$"# title="^File Operation Progress$"
    baba-is-float true
}

// ·· File chooser dialogs from any app ··
// NOTE: heights were 900, which is taller than both of your screens
// (768 and ~831 logical px), so they were being clipped. Adjusted.
window-rule {
    match title="^File Upload"
    match title="^Create New Folder"
    match title="^Select Folder to Upload"
    min-width 800
    max-width 1176
    min-height 500
    max-height 650
    open-floating true
}

// ·· Privacy: hide from screen capture / screen share ··
window-rule {
    match app-id="polkit-gnome-authentication-agent-1"
    match app-id=r#"^Bitwarden$"#
    match app-id=r#"^org\.keepassxc\.KeePassXC$"#
    block-out-from "screen-capture"
}

// ·· Workspace  (terminal) ··
window-rule {
    match app-id=r#"^kitty$"#
    open-on-workspace "\u{f120}"
    open-maximized true
    opacity 0.8
    background-effect {
        xray true
        blur true
    }
}

// ·· Workspace  (browsers) ··
window-rule {
    match app-id=r#"zen$"#
    match app-id=r#"vivaldi-stable$"#
    match app-id=r#"chromium$"#
    match app-id=r#"qutebrowser$"#
    match app-id=r#"librewolf$"#
    match app-id=r#"google-chrome$"#
    match app-id=r#"^firefox$"#
    match app-id=r#"browser$"#
    open-on-workspace "\u{f0ac}"
    open-focused true
    default-column-width { proportion 0.9; }
    opacity 0.92
    background-effect {
        blur true
    }
}

// Picture-in-picture: small, floating, bottom-right, fully opaque.
// (Placed AFTER the browser rule so it overrides width/opacity/workspace.)
window-rule {
    match app-id=r#"zen$"# title="^Picture-in-Picture$"
    match app-id=r#"librewolf$"# title="^Picture-in-Picture$"
    match app-id=r#"firefox$"# title="^Picture-in-Picture$"
    open-floating true
    open-focused false
    opacity 1.0
    default-column-width { fixed 480; }
    default-window-height { fixed 270; }
    default-floating-position x=24 y=24 relative-to="bottom-right"
}

// ·· Workspace  (editors & IDEs) ··
window-rule {
    match app-id=r#"^neovide$"#
    match app-id=r#"^dev\.zed\.Zed$"#
    match app-id=r#"^jetbrains-idea$"#
    match app-id=r#"^codium$"#
    match app-id=r#"^com\.microsoft\.VSCode$"#
    match app-id=r#"^Vivado$"# title=r#"^Vivado 2022\.2$"#
    match app-id=r#"^Vitis IDE$"#
    match app-id=r#"^uv4\.exe"#
    match app-id=r#"^Eclipse$"#
    match app-id=r#"^STM32CubeIDE$"# title=r#"STM32CubeIDE $"#
    match app-id=r#"^labwc$"#
    match app-id=r#"^gvim$"#
    match app-id=r#"^kitty$"# title=r#"^\[nvim\]$"#
    open-on-workspace "\u{f121}"   // enable to pin editors to the code workspace
    open-focused true
    open-maximized true
}

window-rule {
    match app-id=r#"^codium$"#
    match app-id=r#"^dev\.zed\.Zed$"#
    opacity 0.9
    background-effect {
        blur true
    }
}

// ·· Documents, media, misc ··
window-rule {
    match app-id=r#"org\.pwmt\.zathura"#
    match app-id=r#"com\.github\.johnfactotum\.Foliate"#
    match app-id=r#"^org\.gnome\.Papers$"#
    open-focused true
    default-column-width { proportion 0.75; }
}

window-rule {
    match app-id=r#"^com\.obsproject\.Studio$"#
    match app-id=r#"^vesktop$"#
    match app-id=r#"^org\.gnome\.Snapshot$"#
    open-focused true
}

// OBS gets a comfortable starting width instead of an over-narrow column
window-rule {
    match app-id=r#"^com\.obsproject\.Studio$"#
    default-column-width { proportion 0.5; }
}

// VMs & office suites
window-rule {
    match app-id=r#"^virt-manager$"# title=r#"^.*QEMU/KVM$"#
    match app-id=r#"^libreoffice.*$"#
    match app-id=r#"^soffice$"#
    open-focused true
    open-maximized true
}

// ·· QtScrcpy ··
window-rule {
    match app-id=r#"QtScrcpy$"# title="^Phone-"
    default-column-width { proportion 0.25; }
}

window-rule {
    match app-id=r#"QtScrcpy$"# title="^Tool$"
    open-floating false
    default-column-width {}
}

// ── Keybindings ─────────────────────────────────────────────────────────────
binds {
    // ────────────────────────────────────────────────────────────────────────
    // ── LAUNCHERS & APPLICATIONS ────────────────────────────────────────────
    // ────────────────────────────────────────────────────────────────────────
    Mod+Slash hotkey-overlay-title="Keybindings" {
        spawn "kitty" "--class" "tui-overlay" "-e" "niri-keybinds"
    }

    Mod+Return { spawn "default-terminal"; }
    Mod+Alt+Return { spawn "default-terminal" "-e" "tmux" "new-session" "-A" "-s" "main"; }

    // Scratchpad terminal
    Mod+S { spawn "kitty" "--class" "scratchpad" "-e" "tmux" "new-session" "-A" "-s" "scratchpad"; }

    Mod+B { spawn "default-browser"; }
    Mod+Shift+Alt+B hotkey-overlay-title="Open Private Browser" { spawn "default-browser-private"; }

    Mod+E { spawn "default-fm"; }
    Mod+C { spawn "default-editor"; }
    Mod+Shift+S hotkey-overlay-title="Edit niri config" { spawn-sh "kitty nvim ~/.config/niri/config.kdl"; }

    // ── PINNED APPS (taskbar-style: focus / cycle / launch) ─────────────────
    Mod+1 { spawn "focus-or-launch" "kitty" "default-terminal"; }
    Mod+2 { spawn "focus-or-launch" "firefox" "default-browser"; }
    Mod+3 { spawn "focus-or-launch" "com.microsoft.VSCode" "code"; }
    Mod+4 { spawn "focus-or-launch" "thunar" "default-fm"; }
    Mod+5 { spawn "focus-or-launch" "vesktop" "vesktop"; }
    Mod+6 { spawn "focus-or-launch" "org.pwmt.zathura" "zathura"; }

    Mod+D { spawn-sh "pkill fuzzel || fuzzel"; }
    Mod+Comma hotkey-overlay-title="Show Emojis" repeat=false { spawn-sh "pkill fuzzel || fuzzel-emoji"; }

    Mod+V { spawn "cliphist-picker"; }
    Mod+W repeat=false { spawn "kitty" "--class" "tui-overlay" "-e" "bash" "-lc" "exec \"$HOME/.local/bin/wallpaper-picker.sh\""; }
    Mod+Alt+W hotkey-overlay-title="Random Wallpaper" { spawn "random-wallpaper"; }

    // Cycle night light (Off → 4500K → 3500K → 2700K)
    Mod+N { spawn "nightlight-cycle"; }

    // ────────────────────────────────────────────────────────────────────────
    // ── SYSTEM & OVERLAYS ───────────────────────────────────────────────────
    // ────────────────────────────────────────────────────────────────────────
    Mod+Shift+B hotkey-overlay-title="Toggle Waybar" repeat=false { spawn "toggle-waybar"; }
    Mod+O hotkey-overlay-title="Toggle Overview" repeat=false { toggle-overview; }
    Mod+Alt+L { spawn "swaylock"; }
    Mod+Shift+Q { spawn "way-powermenu"; }
    Mod+Shift+P { power-off-monitors; }

    // Handy for VMs / remote desktops: let apps grab all shortcuts
    Mod+Escape allow-inhibiting=false { toggle-keyboard-shortcuts-inhibit; }

    // System-management TUIs
    Mod+Ctrl+P { spawn "kitty" "--class" "tui-overlay" "-e" "pkg-manage"; }
    Mod+Ctrl+A { spawn "kitty" "--class" "tui-overlay" "-e" "wiremix"; }
    Mod+Ctrl+B { spawn "kitty" "--class" "tui-overlay" "-e" "bluetui"; }
    Mod+Ctrl+W { spawn-sh "NEWT_COLORS=$(tr '\\n' ' ' < ~/.config/nmtui/theme) kitty --class tui-overlay -e nmtui"; }
    Mod+Ctrl+S { spawn "kitty" "--class" "tui-overlay" "-e" "btop"; }
    Mod+Ctrl+D { spawn "kitty" "--class" "tui-overlay" "-e" "lazydocker"; }
    Mod+Ctrl+N { spawn "swaync-client" "-t" "-sw"; }

    // ────────────────────────────────────────────────────────────────────────
    // ── WINDOW MANAGEMENT & CLOSING ─────────────────────────────────────────
    // ────────────────────────────────────────────────────────────────────────
    Mod+Q { close-window; }
    Alt+F4 { close-window; }

    Mod+Ctrl+Shift+Delete hotkey-overlay-title="Kill all windows (Global)" {
        spawn "sh" "-c" "niri msg --json windows | jq -r '.[].id' | xargs -r -I {} niri msg action close-window --id {}"
    }

    Mod+Alt+Delete hotkey-overlay-title="Kill all except focused (Global)" {
        spawn "sh" "-c" "niri msg --json windows | jq -r '.[] | select(.is_focused == false) | .id' | xargs -r -I {} niri msg action close-window --id {}"
    }

    Mod+Ctrl+Delete hotkey-overlay-title="Kill all except focused (Workspace)" {
        spawn "sh" "-c" "niri msg --json windows | jq -r '(.[] | select(.is_focused == true) | .workspace_id) as $ws | .[] | select(.workspace_id == $ws and .is_focused == false) | .id' | xargs -r -I {} niri msg action close-window --id {}"
    }

    Mod+Shift+Delete hotkey-overlay-title="Kill all on current workspace" {
        spawn "sh" "-c" "niri msg --json windows | jq -r '(.[] | select(.is_focused == true) | .workspace_id) as $ws | .[] | select(.workspace_id == $ws) | .id' | xargs -r -I {} niri msg action close-window --id {}"
    }

    // ────────────────────────────────────────────────────────────────────────
    // ── NAVIGATION & FOCUS ──────────────────────────────────────────────────
    // ────────────────────────────────────────────────────────────────────────
    Mod+H     { focus-column-left; }
    Mod+L     { focus-column-right; }
    Mod+J     { focus-window-down; }
    Mod+K     { focus-window-up; }
    Mod+Left  { focus-column-left; }
    Mod+Right { focus-column-right; }
    Mod+Up    { focus-window-up; }
    Mod+Down  { focus-window-down; }

    Mod+Home  { focus-column-first; }
    Mod+End   { focus-column-last; }

    // Move windows / columns
    Mod+Shift+H     { move-column-left; }
    Mod+Shift+L     { move-column-right; }
    Mod+Shift+J     { move-window-down-or-to-workspace-down; }
    Mod+Shift+K     { move-window-up-or-to-workspace-up; }
    Mod+Shift+Left  { move-column-left; }
    Mod+Shift+Right { move-column-right; }
    Mod+Shift+Down  { move-window-down-or-to-workspace-down; }
    Mod+Shift+Up    { move-window-up-or-to-workspace-up; }

    Mod+Ctrl+Home   { move-column-to-first; }
    Mod+Ctrl+End    { move-column-to-last; }

    // Monitor focus
    Mod+Ctrl+H     { focus-monitor-left; }
    Mod+Ctrl+J     { focus-monitor-down; }
    Mod+Ctrl+K     { focus-monitor-up; }
    Mod+Ctrl+L     { focus-monitor-right; }
    Mod+Ctrl+Left  { focus-monitor-left; }
    Mod+Ctrl+Down  { focus-monitor-down; }
    Mod+Ctrl+Up    { focus-monitor-up; }
    Mod+Ctrl+Right { focus-monitor-right; }

    // Move column to another monitor
    Mod+Shift+Ctrl+H     { move-column-to-monitor-left; }
    Mod+Shift+Ctrl+J     { move-column-to-monitor-down; }
    Mod+Shift+Ctrl+K     { move-column-to-monitor-up; }
    Mod+Shift+Ctrl+L     { move-column-to-monitor-right; }
    Mod+Shift+Ctrl+Left  { move-column-to-monitor-left; }
    Mod+Shift+Ctrl+Down  { move-column-to-monitor-down; }
    Mod+Shift+Ctrl+Up    { move-column-to-monitor-up; }
    Mod+Shift+Ctrl+Right { move-column-to-monitor-right; }

    // ────────────────────────────────────────────────────────────────────────
    // ── SIZING, LAYOUT & FLOATING ───────────────────────────────────────────
    // ────────────────────────────────────────────────────────────────────────
    Mod+Minus       { set-column-width "-10%"; }
    Mod+Equal       { set-column-width "+10%"; }
    Mod+Shift+Minus { set-window-height "-10%"; }
    Mod+Shift+Equal { set-window-height "+10%"; }
    Mod+0           { set-column-width "100%"; }
    Mod+R           { switch-preset-column-width; }
    Mod+Shift+R     { switch-preset-window-height; }
    Mod+Ctrl+R      { reset-window-height; }

    Mod+F           { maximize-window-to-edges; }
    Mod+Shift+F     { fullscreen-window; }
    Mod+Alt+F       { maximize-column; }
    Mod+Ctrl+F      { expand-column-to-available-width; }
    Mod+Ctrl+C      { center-column; }

    Mod+Shift+Space { toggle-window-floating; }
    Mod+Space       { switch-focus-between-floating-and-tiling; }

    // Column consuming / expelling / tabs
    Mod+G            { consume-window-into-column; }
    Mod+Alt+G        { expel-window-from-column; }
    Mod+Bracketleft  { consume-or-expel-window-left; }
    Mod+Bracketright { consume-or-expel-window-right; }
    Mod+Alt+T        { toggle-column-tabbed-display; }

    // ────────────────────────────────────────────────────────────────────────
    // ── WORKSPACES ──────────────────────────────────────────────────────────
    // ────────────────────────────────────────────────────────────────────────
    Mod+Ctrl+1 { focus-workspace 1; }
    Mod+Ctrl+2 { focus-workspace 2; }
    Mod+Ctrl+3 { focus-workspace 3; }
    Mod+Ctrl+4 { focus-workspace 4; }
    Mod+Ctrl+5 { focus-workspace 5; }
    Mod+Ctrl+6 { focus-workspace 6; }
    Mod+Ctrl+7 { focus-workspace 7; }
    Mod+Ctrl+8 { focus-workspace 8; }
    Mod+Ctrl+9 { focus-workspace 9; }

    Mod+Ctrl+Shift+1 { move-column-to-workspace 1; }
    Mod+Ctrl+Shift+2 { move-column-to-workspace 2; }
    Mod+Ctrl+Shift+3 { move-column-to-workspace 3; }
    Mod+Ctrl+Shift+4 { move-column-to-workspace 4; }
    Mod+Ctrl+Shift+5 { move-column-to-workspace 5; }
    Mod+Ctrl+Shift+6 { move-column-to-workspace 6; }
    Mod+Ctrl+Shift+7 { move-column-to-workspace 7; }
    Mod+Ctrl+Shift+8 { move-column-to-workspace 8; }
    Mod+Ctrl+Shift+9 { move-column-to-workspace 9; }

	// Moving the active window to the stash (minimize) workspace
    Mod+Shift+M       { focus-workspace "stash"; }
    // Toggle focus directly to the stash (minimize) workspace
	Mod+M { move-window-to-workspace "stash" focus=false; }

    Mod+Tab       { focus-workspace-down; }
    Mod+Shift+Tab { focus-workspace-up; }
    Mod+Grave     { focus-workspace-previous; }

    Mod+Alt+J { move-workspace-down; }
    Mod+Alt+K { move-workspace-up; }

    // ────────────────────────────────────────────────────────────────────────
    // ── MOUSE WHEEL ─────────────────────────────────────────────────────────
    // ────────────────────────────────────────────────────────────────────────
    Mod+WheelScrollDown       cooldown-ms=150 { focus-workspace-down; }
    Mod+WheelScrollUp         cooldown-ms=150 { focus-workspace-up; }
    Mod+Ctrl+WheelScrollDown  cooldown-ms=150 { move-column-to-workspace-down; }
    Mod+Ctrl+WheelScrollUp    cooldown-ms=150 { move-column-to-workspace-up; }

    Mod+Shift+WheelScrollDown { focus-column-right; }
    Mod+Shift+WheelScrollUp   { focus-column-left; }
    Mod+WheelScrollRight      { focus-column-right; }
    Mod+WheelScrollLeft       { focus-column-left; }

    // ────────────────────────────────────────────────────────────────────────
    // ── HARDWARE (SwayOSD) ──────────────────────────────────────────────────
    // ────────────────────────────────────────────────────────────────────────
    // allow-when-locked lets these keep working on the lock screen
    XF86AudioRaiseVolume   allow-when-locked=true { spawn "swayosd-client" "--output-volume" "raise"; }
    XF86AudioLowerVolume   allow-when-locked=true { spawn "swayosd-client" "--output-volume" "lower"; }
    XF86AudioMute          allow-when-locked=true { spawn "swayosd-client" "--output-volume" "mute-toggle"; }
    XF86MonBrightnessUp    allow-when-locked=true { spawn "swayosd-client" "--brightness" "raise"; }
    XF86MonBrightnessDown  allow-when-locked=true { spawn "swayosd-client" "--brightness" "lower"; }
    XF86AudioPlay          allow-when-locked=true { spawn "swayosd-client" "--playerctl" "play-pause"; }
    XF86AudioNext          allow-when-locked=true { spawn "swayosd-client" "--playerctl" "next"; }
    XF86AudioPrev          allow-when-locked=true { spawn "swayosd-client" "--playerctl" "previous"; }

    // Plain wpctl / brightnessctl alternative (no OSD):
    // XF86AudioRaiseVolume { spawn "wpctl" "set-volume" "@DEFAULT_AUDIO_SINK@" "5%+"; }
    // XF86AudioLowerVolume { spawn "wpctl" "set-volume" "@DEFAULT_AUDIO_SINK@" "5%-"; }
    // XF86AudioMute        { spawn "wpctl" "set-mute" "@DEFAULT_AUDIO_SINK@" "toggle"; }
    // XF86MonBrightnessUp  { spawn "brightnessctl" "set" "+5%"; }
    // XF86MonBrightnessDown { spawn "brightnessctl" "set" "5%-"; }

    // ────────────────────────────────────────────────────────────────────────
    // ── SCREENSHOTS & TOOLS ─────────────────────────────────────────────────
    // ────────────────────────────────────────────────────────────────────────
    Print      { screenshot; }
    Ctrl+Print { screenshot-screen; }
    Alt+Print  { screenshot-window; }

    Mod+Print hotkey-overlay-title="Color Picker" { spawn-sh "hyprpicker -a || colorpicker"; }
    Mod+P repeat=false hotkey-overlay-title="Mirror focused output" { spawn-sh "wl-mirror $(niri msg --json focused-output | jq -r .name)"; }
}

// ── Autostart ───────────────────────────────────────────────────────────────
// Environment first, so everything below sees WAYLAND_DISPLAY etc.
spawn-at-startup "dbus-update-activation-environment" "--systemd" "WAYLAND_DISPLAY" "XDG_CURRENT_DESKTOP" "NIRI_SOCKET"

// Portals
spawn-at-startup "/usr/lib/xdg-desktop-portal-gnome"   // or xdg-desktop-portal-gtk
spawn-at-startup "/usr/lib/xdg-desktop-portal"

// Auth
spawn-at-startup "/usr/lib/polkit-gnome/polkit-gnome-authentication-agent-1"

// Wallpaper (second instance renders behind the overview)
spawn-at-startup "awww-daemon"
spawn-at-startup "awww-daemon" "-n" "overview-wall"

// Shell UI
spawn-at-startup "waybar"
spawn-at-startup "swaync"                              // swap for "mako" if preferred
spawn-at-startup "swayosd-server"
spawn-at-startup "udiskie" "--smart-tray"

// Clipboard history
spawn-at-startup "wl-paste" "--type" "text"  "--watch" "cliphist" "store"
spawn-at-startup "wl-paste" "--type" "image" "--watch" "cliphist" "store"

// Misc
spawn-at-startup "niri-screen-time" "-daemon"
spawn-at-startup "wname" "LG4D"                        // Java-app compositor-name hack

// If you want niri-managed X11 apps again, delete the `xwayland-satellite { off }`
// block above and the DISPLAY line in `environment`; niri will spawn it on demand.
// Otherwise start your own on :1, e.g.:
// spawn-at-startup "xwayland-satellite" ":1"
